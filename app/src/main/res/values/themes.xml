<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Bounty" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bounty_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/bounty_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/bounty_background</item>
        <item name="colorSurface">@color/bounty_surface</item>
        <item name="colorOnSurface">@color/bounty_text</item>
    </style>

    <style name="Theme.Bounty" parent="Base.Theme.Bounty" />
    <style name="BountyHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="BountyBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="BountyButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="BountyTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">?attr/colorOnSurface</item>
    </style>
    <style name="BountyScreen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fillViewport">true</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="BountyScreenContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>
    <style name="BountySection" parent="BountyBody">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BountyNavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bounty_primary</item>
    </style>
    <style name="BountyCaption" parent="BountyBody">
        <item name="android:textSize">13sp</item>
    </style>
    <style name="BountyReward" parent="BountySection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@color/bounty_primary</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">4dp</item>
    </style>
    <style name="BountyStatus" parent="BountyCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
