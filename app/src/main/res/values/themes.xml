<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Bounty" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/nunito</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="colorPrimary">@color/bounty_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/bounty_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/bounty_on_primary_container</item>
        <item name="colorSecondary">@color/bounty_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/bounty_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/bounty_on_secondary_container</item>
        <item name="colorTertiary">@color/bounty_tertiary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/bounty_tertiary_container</item>
        <item name="android:colorBackground">@color/bounty_background</item>
        <item name="colorSurface">@color/bounty_surface</item>
        <item name="colorOnSurface">@color/bounty_text</item>
        <item name="colorOutline">@color/bounty_outline_variant</item>
        <item name="materialAlertDialogTheme">@style/BountyDialog</item>
    </style>

    <style name="Theme.Bounty" parent="Base.Theme.Bounty" />

    <style name="BountyHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="BountyBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="BountyButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_btn_duolingo_3d_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="elevation">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="BountySecondaryButton" parent="BountyButton">
        <item name="backgroundTint">@color/bounty_surface_container_low</item>
        <item name="android:textColor">@color/bounty_primary</item>
        <item name="strokeColor">@color/bounty_primary_container</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="BountyDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/BountyDialogShape</item>
        <item name="colorSurface">@color/bounty_surface</item>
        <item name="buttonBarPositiveButtonStyle">@style/BountyDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/BountyDialogButton</item>
    </style>

    <style name="BountyDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/bounty_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BountyDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="BountyTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/bounty_primary</item>
        <item name="hintTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="BountyScreen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fillViewport">true</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="BountyScreenContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <style name="BountySection" parent="BountyBody">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="BountyNavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="BountyNavigationLabelActive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="BountyNavigationLabelInactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="BountyCaption" parent="BountyBody">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/bounty_text_secondary</item>
    </style>

    <style name="BountyReward" parent="BountySection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/bg_reward</item>
        <item name="android:textColor">@color/bounty_gold_text</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BountyStatus" parent="BountyCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
