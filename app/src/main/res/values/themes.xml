<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Bounty" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bounty_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/bounty_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/bounty_background</item>
        <item name="colorSurface">@color/bounty_surface</item>
        <item name="colorOnSurface">@color/bounty_text</item>
    </style>

    <style name="Theme.Bounty" parent="Base.Theme.Bounty" />
    <style name="BountyHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="BountyBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="BountyButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="BountyTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">?attr/colorOnSurface</item>
    </style>
</resources>
