<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Sent Message Row (Right-aligned Indigo Bubble) -->
    <LinearLayout
        android:id="@+id/msg_sent_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/msg_sent_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_sent"
            android:fontFamily="@font/nunito"
            android:paddingHorizontal="16dp"
            android:paddingVertical="11dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:id="@+id/msg_sent_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/nunito"
            android:textColor="@color/bounty_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Received Message Row (Left-aligned Avatar + White Bubble) -->
    <LinearLayout
        android:id="@+id/msg_received_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|bottom"
        android:orientation="horizontal"
        android:paddingEnd="56dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/msg_received_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_avatar"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/msg_received_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bubble_received"
                android:fontFamily="@font/nunito"
                android:paddingHorizontal="16dp"
                android:paddingVertical="11dp"
                android:textColor="@color/bounty_text"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/msg_received_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/nunito"
                android:textColor="@color/bounty_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
