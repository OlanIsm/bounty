<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_screen"
    style="@style/BountyScreen"
    android:background="@color/bounty_background">

    <LinearLayout
        style="@style/BountyScreenContent"
        android:paddingBottom="100dp">

        <!-- 1. Profile Header / Data Diri Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/bounty_surface_container"
            app:cardBackgroundColor="@color/bounty_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Avatar Ring -->
                    <ImageView
                        android:id="@+id/profile_avatar_view"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_avatar"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_name"
                            style="@style/BountyHeading"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.01" />

                        <TextView
                            android:id="@+id/user_email"
                            style="@style/BountyBody"
                            android:textSize="13sp"
                            android:textColor="@color/bounty_text_secondary"
                            android:layout_marginTop="2dp"
                            android:textIsSelectable="true" />

                        <!-- Role / Level Tag -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_reward"
                                android:backgroundTint="@color/bounty_primary_fixed"
                                android:textColor="@color/bounty_on_primary_fixed"
                                android:text="Hunter &amp; Creator"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_reward"
                                android:backgroundTint="@color/status_open_bg"
                                android:textColor="@color/status_open_fg"
                                android:text="Terverifikasi"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Credentials Info Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/bounty_surface_container_low"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_shield_check"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <TextView
                        style="@style/BountyCaption"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/bounty_text_secondary"
                        android:text="@string/signed_in_note" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Big Demo Balance Highlight -->
        <include layout="@layout/component_demo_balance" />

        <!-- 2. Section: Data Diri & Profil -->
        <TextView
            style="@style/BountySection"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:textSize="16sp"
            android:text="@string/profile_section_account" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/bounty_surface_container"
            app:cardBackgroundColor="@color/bounty_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Edit Profile Item -->
                <LinearLayout
                    android:id="@+id/menu_edit_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/bounty_primary"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/BountyHeading"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:text="@string/profile_edit" />

                        <TextView
                            style="@style/BountyCaption"
                            android:textSize="12sp"
                            android:textColor="@color/bounty_text_secondary"
                            android:text="@string/profile_edit_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="52dp"
                    android:background="@color/bounty_surface_container" />

                <!-- Riwayat Aktivitas Item -->
                <LinearLayout
                    android:id="@+id/menu_activity_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_challenges"
                        app:tint="@color/bounty_primary"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/BountyHeading"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:text="@string/profile_history" />

                        <TextView
                            style="@style/BountyCaption"
                            android:textSize="12sp"
                            android:textColor="@color/bounty_text_secondary"
                            android:text="@string/profile_history_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Section: Preferensi -->
        <TextView
            style="@style/BountySection"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:textSize="16sp"
            android:text="@string/profile_section_preferences" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/bounty_surface_container"
            app:cardBackgroundColor="@color/bounty_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Notifikasi Item with Switch -->
                <LinearLayout
                    android:id="@+id/menu_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_bell"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/BountyHeading"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:text="@string/profile_pref_notifications" />

                        <TextView
                            style="@style/BountyCaption"
                            android:textSize="12sp"
                            android:textColor="@color/bounty_text_secondary"
                            android:text="@string/profile_pref_notifications_desc" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_notifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="52dp"
                    android:background="@color/bounty_surface_container" />

                <!-- Tema Item -->
                <LinearLayout
                    android:id="@+id/menu_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_settings"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/BountyHeading"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:text="@string/profile_pref_theme" />

                        <TextView
                            style="@style/BountyCaption"
                            android:textSize="12sp"
                            android:textColor="@color/bounty_text_secondary"
                            android:text="@string/profile_pref_theme_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="52dp"
                    android:background="@color/bounty_surface_container" />

                <!-- Bahasa Item -->
                <LinearLayout
                    android:id="@+id/menu_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_home"
                        app:tint="@color/bounty_primary"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/BountyHeading"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:text="@string/profile_pref_language" />

                        <TextView
                            style="@style/BountyCaption"
                            android:textSize="12sp"
                            android:textColor="@color/bounty_text_secondary"
                            android:text="@string/profile_pref_language_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Section: Pengaturan & Bantuan -->
        <TextView
            style="@style/BountySection"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:textSize="16sp"
            android:text="@string/profile_section_settings" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/bounty_surface_container"
            app:cardBackgroundColor="@color/bounty_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Keamanan Item -->
                <LinearLayout
                    android:id="@+id/menu_security"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/bounty_primary"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/BountyHeading"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:text="@string/profile_setting_security" />

                        <TextView
                            style="@style/BountyCaption"
                            android:textSize="12sp"
                            android:textColor="@color/bounty_text_secondary"
                            android:text="@string/profile_setting_security_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="52dp"
                    android:background="@color/bounty_surface_container" />

                <!-- Bantuan & FAQ Item -->
                <LinearLayout
                    android:id="@+id/menu_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sad_robot"
                        app:tint="@color/bounty_primary"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/BountyHeading"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:text="@string/profile_setting_help" />

                        <TextView
                            style="@style/BountyCaption"
                            android:textSize="12sp"
                            android:textColor="@color/bounty_text_secondary"
                            android:text="@string/profile_setting_help_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="52dp"
                    android:background="@color/bounty_surface_container" />

                <!-- Tentang Bounty Item -->
                <LinearLayout
                    android:id="@+id/menu_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_trophy"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/BountyHeading"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:text="@string/profile_setting_about" />

                        <TextView
                            style="@style/BountyCaption"
                            android:textSize="12sp"
                            android:textColor="@color/bounty_text_secondary"
                            android:text="@string/profile_setting_about_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Logout Action Button at Bottom -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logout_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconTint="@color/bounty_on_error_container"
            app:backgroundTint="@color/bounty_error_container"
            android:textColor="@color/bounty_on_error_container"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/logout_action" />

        <!-- Hidden Compatibility Container for Tests / Retrofit -->
        <LinearLayout
            android:id="@+id/legacy_demo_users_wrapper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/demo_users_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/demo_users_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/demo_users_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/demo_users_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
