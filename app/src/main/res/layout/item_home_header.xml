<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Top Colored Section (Edge-to-Edge like Challenge Page) -->
    <LinearLayout
        android:id="@+id/home_header_hero_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bounty_primary"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- Top Greeting + Quick Gamification Badges (Duolingo Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/home_user_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_avatar"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/welcome_text"
                    style="@style/BountyHeading"
                    android:textSize="20sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/home_user_subtitle"
                    style="@style/BountyCaption"
                    android:textSize="12sp"
                    android:textColor="#D5D7FF"
                    android:text="Bounty Hunter • Siap berburu!" />
            </LinearLayout>
        </LinearLayout>

        <!-- Balance Card -->
        <include layout="@layout/component_demo_balance" />
    </LinearLayout>

    <!-- Rounded Transition Graphic (Curve Transition) -->
    <ImageView
        android:id="@+id/home_curve_divider"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_curve_transition"
        android:importantForAccessibility="no" />

    <!-- Main Content Container (Padded 16dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Gamified Quest Stats (3 Pills: Attempted, Created, Rank) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <!-- Stat 1: Attempted / Diikuti -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#204648D4"
                app:cardBackgroundColor="@color/bounty_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_target"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/stat_attempted_count"
                        style="@style/BountyHeading"
                        android:layout_width="wrap_content"
                        android:textSize="18sp"
                        android:textColor="@color/bounty_primary"
                        android:layout_marginTop="4dp"
                        android:text="0" />

                    <TextView
                        style="@style/BountyCaption"
                        android:layout_width="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/bounty_text_secondary"
                        android:text="Diikuti" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stat 2: Created / Dibuat -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#20FF7A00"
                app:cardBackgroundColor="@color/bounty_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_create"
                        app:tint="#FF7A00"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/stat_created_count"
                        style="@style/BountyHeading"
                        android:layout_width="wrap_content"
                        android:textSize="18sp"
                        android:textColor="#FF7A00"
                        android:layout_marginTop="4dp"
                        android:text="0" />

                    <TextView
                        style="@style/BountyCaption"
                        android:layout_width="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/bounty_text_secondary"
                        android:text="Dibuat" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stat 3: Rank / Peringkat -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#20F59E0B"
                app:cardBackgroundColor="@color/bounty_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_trophy"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/stat_leaderboard_rank"
                        style="@style/BountyHeading"
                        android:layout_width="wrap_content"
                        android:textSize="18sp"
                        android:textColor="@color/bounty_gold_accent"
                        android:layout_marginTop="4dp"
                        android:text="#-" />

                    <TextView
                        style="@style/BountyCaption"
                        android:layout_width="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/bounty_text_secondary"
                        android:text="Ranking" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Followed Hunters / Teman Aktif Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/home_hunters_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/bounty_text"
                android:text="Hunter &amp; Teman Aktif" />

            <TextView
                android:id="@+id/btn_see_all_hunters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bounty_primary"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Lihat Semua &gt;" />
        </LinearLayout>

        <!-- Empty Hunters Card when not loaded / no hunters -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_hunters_empty_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/bounty_surface_container"
            app:cardBackgroundColor="@color/bounty_surface"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_avatar"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bounty_text"
                        android:text="Belum ada hunter tampil" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito"
                        android:textSize="12sp"
                        android:textColor="@color/bounty_text_secondary"
                        android:text="Muat daftar untuk temukan teman baru!" />
                </LinearLayout>

                <TextView
                    android:id="@+id/home_hunters_load_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_duolingo_3d_primary"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp"
                    android:text="Muat Teman" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Horizontal Scroll of Active Hunters to Follow -->
        <HorizontalScrollView
            android:id="@+id/home_hunters_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/home_followed_users_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Duolingo-style 3D Action Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_banner_create"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/bounty_surface_container"
            app:cardBackgroundColor="@color/bounty_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/bounty_text"
                        android:text="Punya Ide Tantangan?" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito"
                        android:textSize="12sp"
                        android:textColor="@color/bounty_text_secondary"
                        android:layout_marginTop="2dp"
                        android:text="Buat challenge dan bagi hadiah ke hunter lain!" />
                </LinearLayout>

                <!-- Duolingo 3D Button -->
                <TextView
                    android:id="@+id/home_quick_create_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_btn_duolingo_3d_green"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="14dp"
                    android:text="+ Buat" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Available Challenges Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/bounty_text"
                android:text="Misi Tersedia Untukmu" />
        </LinearLayout>

        <!-- Empty State Container when no challenges -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_empty_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/bounty_surface_container"
            app:cardBackgroundColor="@color/bounty_surface"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="24dp"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_sad_robot"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/feed_message"
                    android:accessibilityLiveRegion="polite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:fontFamily="@font/nunito"
                    android:textSize="14sp"
                    android:textColor="@color/bounty_text_secondary"
                    android:text="@string/no_available_challenges" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_create_challenge"
                    style="@style/BountyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="44dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_btn_duolingo_3d_green"
                    android:paddingHorizontal="24dp"
                    android:textSize="14sp"
                    android:text="+ Buat Challenge Pertama" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
