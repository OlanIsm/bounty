<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/bounty_surface_container"
    app:cardBackgroundColor="@color/bounty_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Zone: Creator Info + Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/challenge_avatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/challenge_creator"
                    style="@style/BountyBody"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:singleLine="true" />

                <TextView
                    style="@style/BountyCaption"
                    android:textSize="12sp"
                    android:textColor="@color/bounty_tertiary"
                    android:text="Host Terverifikasi" />
            </LinearLayout>

            <TextView
                android:id="@+id/challenge_status"
                style="@style/BountyStatus"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Content Zone: Title + Description -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/challenge_title"
                style="@style/BountySection"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/challenge_description"
                style="@style/BountyBody"
                android:layout_marginTop="6dp"
                android:textColor="@color/bounty_text_secondary"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Deadline with subtle badge -->
            <TextView
                android:id="@+id/challenge_deadline"
                style="@style/BountyCaption"
                android:layout_marginTop="10dp"
                android:textColor="@color/bounty_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Footer / Action Zone (Stitch style tinted bottom bar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bounty_surface_container_low"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/BountyCaption"
                    android:textSize="11sp"
                    android:text="@string/demo_reward"
                    android:textColor="@color/bounty_text_secondary" />

                <TextView
                    android:id="@+id/challenge_reward"
                    style="@style/BountyReward"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_challenge"
                style="@style/BountyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_btn_duolingo_3d_green"
                android:paddingHorizontal="18dp"
                android:textSize="13sp"
                android:text="@string/view_challenge" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
