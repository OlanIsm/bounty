<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#33FFFFFF"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_balance_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Pill Tag: Demo Saldo Aktif -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#2E000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_coin"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/BountyCaption"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:text="@string/demo_balance_label" />
            </LinearLayout>

            <TextView
                style="@style/BountyBody"
                android:textColor="#F5FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:text="Total Saldo Simulasi" />

            <!-- Balance Amount -->
            <TextView
                android:id="@+id/demo_balance_amount"
                style="@style/BountyHeading"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:layout_marginTop="2dp" />

            <!-- Note / Disclaimer -->
            <TextView
                style="@style/BountyCaption"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:text="@string/demo_balance_note" />
        </LinearLayout>

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_coin"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
