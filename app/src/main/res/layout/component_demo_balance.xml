<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/transparent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_balance_card"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Pill Tag: Demo Saldo Aktif -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#33FFFFFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <TextView
                    style="@style/BountyCaption"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:text="@string/demo_balance_label" />
            </LinearLayout>

            <TextView
                style="@style/BountyBody"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="12dp"
                android:text="Total Tabungan Uji Coba" />

            <!-- Balance Amount -->
            <TextView
                android:id="@+id/demo_balance_amount"
                style="@style/BountyHeading"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:layout_marginTop="2dp" />

            <!-- Note / Disclaimer -->
            <TextView
                style="@style/BountyCaption"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:text="@string/demo_balance_note" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
