<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/demo_balance_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#33FFFFFF"
    app:cardBackgroundColor="@android:color/transparent">

    <FrameLayout
        android:id="@+id/demo_balance_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_balance_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/BountyBody"
                    android:textColor="#F5FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:text="Total Saldo Simulasi" />

                <!-- Balance Amount -->
                <TextView
                    android:id="@+id/demo_balance_amount"
                    style="@style/BountyHeading"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Enlarged Coin Icon with Flow & Shiny Animation -->
            <ImageView
                android:id="@+id/demo_balance_coin_icon"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_coin"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Shiny Highlight Overlay View for Animation -->
        <View
            android:id="@+id/demo_balance_shine"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_shine_sweep"
            android:alpha="0.0" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
