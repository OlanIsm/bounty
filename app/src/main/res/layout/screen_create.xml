<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/create_screen" style="@style/BountyScreen">
    <LinearLayout style="@style/BountyScreenContent">
        <com.google.android.material.textview.MaterialTextView
            style="@style/BountyHeading" android:text="@string/create_challenge_title" />
        <com.google.android.material.textview.MaterialTextView
            style="@style/BountyBody" android:layout_marginTop="16dp"
            android:text="@string/create_description" />
        <com.google.android.material.textview.MaterialTextView
            style="@style/BountyBody" android:layout_marginTop="24dp"
            android:text="@string/create_unavailable" />
    </LinearLayout>
</ScrollView>
