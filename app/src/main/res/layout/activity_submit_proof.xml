<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bounty_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/proof_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bounty_surface"
        android:elevation="1dp"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/submit_proof_action"
        app:navigationIcon="@drawable/ic_back"
        app:navigationContentDescription="@string/back_action" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/proof_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:contentDescription="@string/loading_challenges" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout style="@style/BountyScreenContent">

            <TextView
                android:id="@+id/proof_message"
                android:accessibilityLiveRegion="polite"
                style="@style/BountyBody"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/proof_retry"
                style="@style/BountyButton"
                android:text="@string/retry_action"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/proof_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Challenge Info Card (Stitch style) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/bounty_surface_container"
                    app:cardBackgroundColor="@color/bounty_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/BountyCaption"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/bounty_primary"
                            android:text="ACCEPTED → SIAP KIRIM BUKTI" />

                        <TextView
                            android:id="@+id/proof_challenge_title"
                            style="@style/BountyHeading"
                            android:textSize="20sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Media Upload Area Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/bounty_surface_container"
                    app:cardBackgroundColor="@color/bounty_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/BountySection"
                            android:textSize="16sp"
                            android:text="Lampiran Bukti (Wajib)" />

                        <ImageView
                            android:id="@+id/proof_photo"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="12dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:background="@color/bounty_surface_container_low"
                            android:contentDescription="@string/proof_photo_preview" />

                        <TextView
                            android:id="@+id/proof_photo_message"
                            android:accessibilityLiveRegion="polite"
                            style="@style/BountyCaption"
                            android:textSize="13sp"
                            android:textColor="@color/bounty_text_secondary"
                            android:layout_marginTop="10dp"
                            android:text="@string/proof_photo_required" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/choose_proof_photo"
                            style="@style/BountySecondaryButton"
                            android:layout_marginTop="12dp"
                            android:text="@string/choose_proof_photo" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Description Input Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/bounty_surface_container"
                    app:cardBackgroundColor="@color/bounty_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/proof_description_layout"
                            style="@style/BountyTextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/proof_description_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/proof_description_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minLines="3"
                                android:maxLength="2000"
                                android:gravity="top|start" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/proof_saving"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:contentDescription="@string/proof_submitting" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/proof_submit"
                    style="@style/BountyButton"
                    android:layout_marginTop="20dp"
                    android:text="@string/submit_proof_action" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
