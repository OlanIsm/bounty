<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tutorial_card_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingTop="32dp"
    android:paddingBottom="8dp">

    <!-- Speech Bubble Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tutorial_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bounty_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:strokeColor="#304648D4"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <!-- Top Row: Step Counter Pill (pushed right of mascot) + Skip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="76dp">

                <TextView
                    android:id="@+id/tutorial_step_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_reward"
                    android:backgroundTint="@color/bounty_primary_fixed"
                    android:fontFamily="@font/nunito"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/bounty_on_primary_fixed"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tutorial_skip_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="@string/tutorial_skip"
                    android:textColor="@color/bounty_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Thin Progress Track -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/tutorial_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="76dp"
                android:layout_marginTop="8dp"
                app:indicatorColor="@color/bounty_primary"
                app:trackColor="@color/bounty_surface_container"
                app:trackCornerRadius="4dp"
                app:trackThickness="4dp" />

            <!-- Title & Description -->
            <TextView
                android:id="@+id/tutorial_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/nunito"
                android:letterSpacing="-0.01"
                android:textColor="@color/bounty_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tutorial_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/nunito"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/bounty_text_secondary"
                android:textSize="13.5sp" />

            <!-- Interactive Tap Hint Pill (shown on tap-required steps) -->
            <LinearLayout
                android:id="@+id/tutorial_tap_hint_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_reward"
                android:backgroundTint="@color/bounty_primary_fixed"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_target"
                    app:tint="@color/bounty_primary" />

                <TextView
                    android:id="@+id/tutorial_tap_hint_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/nunito"
                    android:text="@string/tutorial_tap_highlighted"
                    android:textColor="@color/bounty_on_primary_fixed"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Action Row (shown on info steps) -->
            <LinearLayout
                android:id="@+id/tutorial_actions_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tutorial_back_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:text="@string/tutorial_prev"
                    android:textColor="@color/bounty_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tutorial_next_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_duolingo_3d_primary"
                    android:fontFamily="@font/nunito"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="14dp"
                    android:text="@string/tutorial_next"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Mascot Peeking Over Top-Left Corner -->
    <ImageView
        android:id="@+id/tutorial_mascot"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="-30dp"
        android:contentDescription="@null"
        android:elevation="14dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/mascot_leaderboard" />
</FrameLayout>
