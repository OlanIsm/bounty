<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/leaderboard_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bounty_background">

    <!-- Orange Hero Banner with Mascot (Edge-to-edge covering status bar) -->
    <LinearLayout
        android:id="@+id/leaderboard_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_leaderboard_header"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">

        <!-- Banner Top Row: Info (Left) + Mascot Graphic (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left Info Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title with Radiant Sparks Motif -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/BountyHeading"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:letterSpacing="-0.02"
                        android:text="@string/leaderboard_title" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_rays_sparkle"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <!-- Subtitle -->
                <TextView
                    style="@style/BountyBody"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:lineSpacingExtra="2dp"
                    android:text="See how you stack up against others!" />
            </LinearLayout>

            <!-- Right Mascot Image (Enlarged to fill right section) -->
            <ImageView
                android:id="@+id/leaderboard_mascot"
                android:layout_width="165dp"
                android:layout_height="160dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="-12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mascot_leaderboard"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Glassmorphism Segmented Toggle Pill (Image 2 style) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/leaderboard_toggle_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_leaderboard_glass_container"
            android:padding="3dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/toggle_creators">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_creators"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="@string/tab_creators"
                android:textSize="13sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/toggle_leaderboard_bg"
                android:textColor="@color/toggle_leaderboard_text"
                app:strokeColor="@color/toggle_leaderboard_stroke"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_hunters"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="@string/tab_hunters"
                android:textSize="13sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/toggle_leaderboard_bg"
                android:textColor="@color/toggle_leaderboard_text"
                app:strokeColor="@color/toggle_leaderboard_stroke"
                app:strokeWidth="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!-- Wavy Curve Transition Divider with Golden Secondary Wave -->
    <ImageView
        android:id="@+id/leaderboard_curve_divider"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_leaderboard_curve_transition"
        android:importantForAccessibility="no" />

    <!-- Content Area below Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Loading Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/leaderboard_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Error State -->
        <LinearLayout
            android:id="@+id/leaderboard_error_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/leaderboard_error_message"
                style="@style/BountyBody"
                android:textColor="@color/bounty_error"
                android:gravity="center"
                android:text="@string/leaderboard_load_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/leaderboard_retry"
                style="@style/BountyButton"
                android:layout_marginTop="12dp"
                android:text="@string/retry_action" />
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/leaderboard_empty_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="40dp"
            android:paddingHorizontal="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_sad_robot"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/leaderboard_empty_message"
                style="@style/BountyBody"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/bounty_text_secondary"
                android:text="@string/no_leaderboard_data" />
        </LinearLayout>

        <!-- Leaderboard Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leaderboard_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />
    </LinearLayout>
</LinearLayout>
