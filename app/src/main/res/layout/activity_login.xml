<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bounty_primary">

    <LinearLayout
        android:id="@+id/auth_root_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Expansive Indigo Visual Hero with Mascot -->
        <FrameLayout
            android:id="@+id/auth_hero_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="230dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/btn_auth_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_circle_translucent"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white"
                android:visibility="gone"
                android:contentDescription="@string/back_action" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Mascot Stage with Radiant Glow -->
                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="184dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/auth_hero_burst"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:alpha="0.28"
                        android:src="@drawable/bg_radiant_burst"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/auth_hero_mascot"
                        android:layout_width="170dp"
                        android:layout_height="170dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mascot_confirmed"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/app_title"
                    style="@style/BountyHeading"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:letterSpacing="-0.02"
                    android:text="@string/login_title" />

                <TextView
                    android:id="@+id/auth_hero_subtitle"
                    style="@style/BountyBody"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="#D5D7FF"
                    android:text="@string/login_hero_subtitle" />

                <!-- Mini Gamified Feature Pills (shown in Login mode) -->
                <LinearLayout
                    android:id="@+id/auth_hero_pills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_reward"
                        android:backgroundTint="#26FFFFFF"
                        android:fontFamily="@font/nunito"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Misi Seru"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_reward"
                        android:backgroundTint="#26FFFFFF"
                        android:fontFamily="@font/nunito"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Reward Demo"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_reward"
                        android:backgroundTint="#26FFFFFF"
                        android:fontFamily="@font/nunito"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Bareng Teman"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Compact Curved White Form Sheet (Smoothly lifts up when Sign Up is toggled) -->
        <LinearLayout
            android:id="@+id/login_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet_top_rounded"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="18dp">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/auth_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Name Field: expands smoothly in Sign Up mode, lifting the sheet upward -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/name_layout"
                style="@style/BountyTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/name_label"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="80"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email_layout"
                style="@style/BountyTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLength="254"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_layout"
                style="@style/BountyTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/password_label"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/login_button"
                style="@style/BountyButton"
                android:layout_marginTop="18dp"
                android:text="@string/login_action" />

            <!-- Divider "atau" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/bounty_outline_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito"
                    android:paddingHorizontal="14dp"
                    android:text="@string/auth_or_divider"
                    android:textColor="@color/bounty_text_secondary"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/bounty_outline_variant" />
            </LinearLayout>

            <!-- Continue with Google Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/google_login_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/bounty_surface_container"
                app:cardBackgroundColor="@color/bounty_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_google"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/nunito"
                        android:text="@string/continue_with_google"
                        android:textColor="@color/bounty_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/register_link"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="44dp"
                android:text="@string/register_link"
                android:textColor="@color/bounty_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
