<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bounty_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Indigo Hero Header (Reference 1 Left Phone) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_chat_list_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:padding="9dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/white"
                    android:contentDescription="@string/back_action" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btn_chat_find_friends"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:padding="9dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/white"
                    android:contentDescription="@string/find_friends_title" />
            </LinearLayout>

            <TextView
                android:id="@+id/chat_list_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito"
                android:textColor="#D5D7FF"
                android:textSize="13sp"
                android:text="Halo!" />

            <TextView
                android:id="@+id/chat_list_count_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:text="0 Percakapan Teman" />

            <!-- Contact List Horizontal Strip -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/nunito"
                android:textColor="#E1E0FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="Daftar Teman" />

            <HorizontalScrollView
                android:id="@+id/chat_contacts_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/chat_contacts_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Curved White Sheet (Reference 1) -->
        <LinearLayout
            android:id="@+id/chat_list_sheet"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet_top_rounded"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp">

            <!-- Pill Filter Header matching Reference 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_reward"
                    android:backgroundTint="@color/bounty_gold_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito"
                        android:text="Pesan Langsung"
                        android:textColor="@color/bounty_gold_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chat_pill_count"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_reward"
                        android:backgroundTint="@color/bounty_text"
                        android:gravity="center"
                        android:fontFamily="@font/nunito"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_threads_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="80dp" />

            <!-- Empty Chat State -->
            <LinearLayout
                android:id="@+id/chat_list_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/bounty_primary"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:fontFamily="@font/nunito"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/bounty_text"
                    android:text="Belum ada obrolan teman" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:fontFamily="@font/nunito"
                    android:textSize="13sp"
                    android:textColor="@color/bounty_text_secondary"
                    android:text="Tambahkan teman dulu untuk mulai ngobrol dan berbagi challenge!" />

                <TextView
                    android:id="@+id/btn_chat_empty_find"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn_duolingo_3d_primary"
                    android:fontFamily="@font/nunito"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="14dp"
                    android:text="Cari Teman"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom-Right Floating + Button (Reference 1) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/find_friends_title"
        android:src="@drawable/ic_create"
        app:backgroundTint="@color/bounty_primary"
        app:tint="@color/white" />
</FrameLayout>
