<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/detail_toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize" app:title="@string/challenge_detail_title"
        app:navigationIcon="@drawable/ic_back" app:navigationContentDescription="@string/back_action" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/detail_loading"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:indeterminate="true" android:contentDescription="@string/loading_challenges" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:padding="16dp">
        <LinearLayout style="@style/BountyScreenContent">
            <com.google.android.material.textview.MaterialTextView android:id="@+id/detail_message"
                style="@style/BountyBody" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/detail_retry"
                style="@style/BountyButton" android:text="@string/retry_action" android:visibility="gone" />
            <LinearLayout android:id="@+id/detail_content" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/challenge_avatar" android:layout_width="40dp"
                        android:layout_height="40dp" android:src="@drawable/ic_avatar" android:importantForAccessibility="no" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/challenge_creator"
                        style="@style/BountyBody" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="12dp" />
                </LinearLayout>
                <com.google.android.material.textview.MaterialTextView android:id="@+id/challenge_title"
                    style="@style/BountyHeading" android:layout_marginTop="24dp" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/challenge_reward"
                    style="@style/BountyReward" android:layout_marginTop="16dp" />
                <com.google.android.material.textview.MaterialTextView style="@style/BountyCaption"
                    android:layout_marginTop="4dp" android:text="@string/demo_reward" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/challenge_description"
                    style="@style/BountyBody" android:layout_marginTop="24dp" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/challenge_deadline"
                    style="@style/BountyBody" android:layout_marginTop="24dp" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/challenge_status"
                    style="@style/BountyStatus" android:layout_marginTop="8dp" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/reward_result"
                    style="@style/BountyBody" android:layout_marginTop="16dp" android:visibility="gone" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/accept_message"
                    style="@style/BountyBody" android:layout_marginTop="16dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/accept_button"
                    style="@style/BountyButton" android:layout_marginTop="16dp"
                    android:text="@string/accept_action" android:enabled="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/submit_proof_button"
                    style="@style/BountyButton" android:layout_marginTop="16dp"
                    android:text="@string/submit_proof_action" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/review_proof_button"
                    style="@style/BountyButton" android:layout_marginTop="16dp"
                    android:text="@string/review_proof_action" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
